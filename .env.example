DATABASE_URL=postgresql://postgres:postgres@localhost:5432/__PACKAGE_NAME__
NUXT_BETTER_AUTH_SECRET=replace-with-a-long-random-secret
NUXT_BETTER_AUTH_URL=http://localhost:3000
NUXT_AUTH_EMAIL_MODE=log

# SMTP placeholder values below are safe local defaults until a real provider is wired.
NUXT_SMTP_HOST=smtp.example.com
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=change-me
NUXT_SMTP_PASS=change-me
NUXT_SMTP_FROM="__APP_NAME__ <hello@example.com>"

# Optional local fallback: the starter also reads unprefixed BETTER_AUTH_* and SMTP_* values.
