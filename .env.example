DATABASE_URL=postgresql://postgres:postgres@localhost:5432/__PACKAGE_NAME__
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
AUTH_EMAIL_MODE=log

# SMTP placeholder values below are safe local defaults until a real provider is wired.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_FROM="__APP_NAME__ <hello@example.com>"
